# Database
# Local dev: a running MySQL instance.
# Production (Cloudflare Workers): must be a network-reachable MySQL
# (PlanetScale, etc.) reached via a Prisma driver adapter or Accelerate —
# a localhost URL will NOT work on Workers. Set it as a Wrangler secret:
#   wrangler secret put DATABASE_URL
DATABASE_URL="mysql://root:admin@localhost:3306/goddess_essence"

# NextAuth
# Generate a strong value: `openssl rand -base64 32`
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
# Must match the origin the app is served from.
NEXTAUTH_URL="http://localhost:3000"
